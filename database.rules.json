{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        ".validate": "$room.matches(/^[A-Z2-9]{6}$/) && newData.hasChildren(['hostUid', 'state', 'ts', 'createdAt']) && (!data.exists() || newData.child('hostUid').val() === data.child('hostUid').val())",
        "hostUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length <= 300000"
        },
        "ts": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('hostUid').exists() && newData.val() === true",
            ".validate": "newData.val() === true"
          }
        },
        "requests": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('members').child(auth.uid).val() === true && (!newData.exists() || !data.exists())",
            ".validate": "newData.hasChildren(['type', 'id']) && ((newData.child('type').val() === 'join' && newData.hasChildren(['name', 'seat'])) || (newData.child('type').val() === 'leave' && newData.hasChild('playerId')) || (newData.child('type').val() === 'action' && newData.hasChildren(['playerId', 'action'])))",
            "type": {
              ".validate": "newData.val() === 'join' || newData.val() === 'leave' || newData.val() === 'action'"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
            },
            "seat": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && newData.val() % 1 === 0"
            },
            "playerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "action": {
              ".validate": "newData.hasChild('type') && (newData.child('type').val() !== 'raise' || newData.hasChild('amount'))",
              "type": {
                ".validate": "newData.val() === 'fold' || newData.val() === 'check' || newData.val() === 'call' || newData.val() === 'raise' || newData.val() === 'allin'"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            },
            "emoji": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomDirectory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$room": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($room).child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['code', 'updatedAt', 'playerCount', 'phase']) && newData.child('code').val() === $room",
          "code": {
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "playerCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "phase": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
